{
  "name": "sons-of-the-forest-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite -c vite-web.config.ts",
    "build": "tsc && vite build -c vite-web.config.ts",
    "web": "tsc && vite build -c vite-web.config.ts && node scripts/prerender.mjs",
    "preview": "vite preview -c vite-web.config.ts",
    "i18n": "node scripts/i18n.mjs",
    "deploy": "tsc && vite build -c vite-web.config.ts && wrangler pages deploy out --project-name sotf-interactive-map"
  },
  "devDependencies": {
    "@translate-tools/core": "1.0.0",
    "@types/async": "3.2.24",
    "@types/js-cookie": "3.0.6",
    "@types/leaflet": "1.9.8",
    "@types/qrcode": "1.5.5",
    "@types/throttle-debounce": "5.0.2",
    "html-to-text": "9.0.5",
    "puppeteer": "19.9.0",
    "typescript": "5.3.3",
    "vite": "5.0.10",
    "vite-plugin-pwa": "0.17.4"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "2.15.0",
    "async": "3.2.5",
    "dotenv": "16.3.1",
    "js-cookie": "3.0.5",
    "leaflet": "1.9.4",
    "peerjs": "1.5.2",
    "qrcode": "1.5.3",
    "reflect-metadata": "0.2.1",
    "throttle-debounce": "5.0.0",
    "zustand": "4.4.7"
  }
}
